# Salin file ini menjadi .env lalu isi nilainya
PORT=3000

# Alamat aplikasi React yang boleh memanggil API ini (pisahkan dengan koma bila lebih dari satu)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Koneksi MySQL (database dibuat dari mysql/01_struktur.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=argaloka_inventaris

# Opsional: set DB_STRICT=true di produksi agar aplikasi berhenti bila MySQL tidak terjangkau
DB_STRICT=false

# Kunci rahasia token login, minimal 16 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=12h

# Stok sama dengan atau di bawah angka ini dianggap menipis
BATAS_STOK_MENIPIS=5
